# NxtGen Traders — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to git.

# ── Supabase (required for live backend) ──────────────────────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# ── Market Data APIs (fallback chain: Twelve Data → Alpha Vantage → stale/mock)
VITE_TWELVE_DATA_KEY=your_twelve_data_api_key
VITE_ALPHA_VANTAGE_KEY=your_alpha_vantage_api_key
VITE_FINNHUB_KEY=your_finnhub_api_key

# ── News ────────────────────────────────────────────────────────────────────
VITE_NEWS_API_KEY=your_newsapi_org_key

# ── Payments (Razorpay) ─────────────────────────────────────────────────────
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxx

# ── PWA Push Notifications ──────────────────────────────────────────────────
VITE_VAPID_PUBLIC_KEY=your_vapid_public_key

# ── App Config ──────────────────────────────────────────────────────────────
VITE_APP_URL=http://localhost:5173
VITE_APP_NAME=NxtGen Traders

# ── Dev mode: set true to use mock data (no API keys required) ─────────────
VITE_USE_MOCK_DATA=false
